<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>StarfighterCompanion.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StarfighterCompanion.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mission lists built into the program (see Data/MissionLists/README.md). -->
    <EmbeddedResource Include="Data\MissionLists\*.lst" />
    <EmbeddedResource Include="Data\CraftLists\*.txt" />
  </ItemGroup>

</Project>
