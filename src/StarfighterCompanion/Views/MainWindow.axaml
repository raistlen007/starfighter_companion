<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StarfighterCompanion.ViewModels"
        xmlns:views="using:StarfighterCompanion.Views"
        x:Class="StarfighterCompanion.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/icon.ico"
        Width="1380" Height="820" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- Content pages (welcome, settings, editor) ease in when they appear. -->
    <Style Selector=":is(Control).page">
      <Setter Property="RenderTransform">
        <TranslateTransform />
      </Setter>
    </Style>
    <Style Selector=":is(Control).page[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.25" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="10" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Menu entries light up smoothly instead of snapping. -->
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,4,0,8" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open file…" InputGesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <MenuItem Header="Save _As…" InputGesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <MenuItem Header="_Revert to saved" Command="{Binding RevertCommand}" />
        <MenuItem Header="_Convert / export…" Command="{Binding ConvertCommand}" />
        <Separator />
        <MenuItem Header="Se_ttings" Command="{Binding ShowSettingsCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="10,4" Background="#1AFFFFFF">
      <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid ColumnDefinitions="290,*">

      <!-- ===================== Game menu ===================== -->
      <Border Grid.Column="0" Background="#0DFFFFFF" Padding="10" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <Button Classes="nav" Content="⚙  Settings" Command="{Binding ShowSettingsCommand}" />
            <Button Classes="nav" Content="Open a pilot file…" Command="{Binding OpenCommand}" />
          </StackPanel>

          <!-- The three pages slide sideways: deeper to the left, back to the right. -->
          <Carousel SelectedIndex="{Binding PageIndex, Mode=OneWay}" Focusable="False" ClipToBounds="True">
            <Carousel.PageTransition>
              <CompositePageTransition>
                <PageSlide Duration="0:0:0.28" Orientation="Horizontal">
                  <PageSlide.SlideInEasing><CubicEaseOut /></PageSlide.SlideInEasing>
                  <PageSlide.SlideOutEasing><CubicEaseOut /></PageSlide.SlideOutEasing>
                </PageSlide>
                <CrossFade Duration="0:0:0.22" />
              </CompositePageTransition>
            </Carousel.PageTransition>

            <!-- Games -->
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="sectionTitle" Text="Games" />
              <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" Margin="2,-4,0,8"
                         Text="Looking for installed games…" IsVisible="{Binding IsDetecting}" />
              <ListBox ItemsSource="{Binding GameItems}" SelectedItem="{Binding SelectedGameItem}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GameItemViewModel">
                    <DockPanel Margin="2,4" Opacity="{Binding Opacity}">
                      <views:GameIconView DockPanel.Dock="Left" Source="{Binding Icon}" Width="32" Height="32"
                                          Margin="0,0,10,0" VerticalAlignment="Center" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Versions of a game -->
            <DockPanel>
              <Button DockPanel.Dock="Top" Classes="nav" Content="←  Back to game menu" Command="{Binding BackToGamesCommand}" />
              <TextBlock DockPanel.Dock="Top" Classes="sectionTitle" Text="{Binding CurrentGameName}" />
              <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" Margin="2,-4,0,8" Text="Choose a version" />
              <ListBox ItemsSource="{Binding VariantItems}" SelectedItem="{Binding SelectedVariantItem}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:VariantItemViewModel">
                    <DockPanel Margin="2,4" Opacity="{Binding Opacity}">
                      <views:GameIconView DockPanel.Dock="Left" Source="{Binding Icon}" Width="28" Height="28"
                                          Margin="0,0,10,0" VerticalAlignment="Center" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Pilots -->
            <DockPanel>
              <Button DockPanel.Dock="Top" Classes="nav" Content="←  Back to game menu" Command="{Binding BackToGamesCommand}" />
              <Button DockPanel.Dock="Top" Classes="nav" Content="←  Other versions" Command="{Binding BackToVariantsCommand}"
                      IsVisible="{Binding CanGoBackToVariants}" />
              <TextBlock DockPanel.Dock="Top" Classes="sectionTitle" Text="{Binding CurrentGameName}" Margin="2,4,0,0" />
              <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentVariantName}" TextWrapping="Wrap" Margin="2,0,0,2"
                         IsVisible="{Binding CanGoBackToVariants}" />
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,6,0,6">
                <TextBlock Grid.Column="0" Text="Pilots" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0" />
                <Button Grid.Column="1" Content="↻ Refresh" Padding="8,2" Command="{Binding RefreshPilotsCommand}" />
              </Grid>
              <TextBlock DockPanel.Dock="Top" Text="{Binding PilotListHint}" IsVisible="{Binding HasPilotListHint}"
                         Classes="muted" TextWrapping="Wrap" Margin="2,0,0,6" />
              <ListBox ItemsSource="{Binding PilotItems}" SelectedItem="{Binding SelectedPilotItem}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PilotItemViewModel">
                    <StackPanel Margin="2,3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Carousel>
        </DockPanel>
      </Border>

      <!-- ===================== Content ===================== -->
      <Panel Grid.Column="1">

        <!-- Welcome -->
        <StackPanel Classes="page" IsVisible="{Binding ShowWelcome}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="560">
          <TextBlock Text="Starfighter Companion" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock TextWrapping="Wrap" TextAlignment="Center" Classes="muted"
                     Text="Pick a game on the left, then a pilot. Installed games are found automatically; if one is missing, set its folder in Settings." />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button Content="⚙  Settings" Padding="16,8" Command="{Binding ShowSettingsCommand}" />
            <Button Content="Open a pilot file…" Padding="16,8" Command="{Binding OpenCommand}" />
          </StackPanel>
          <TextBlock HorizontalAlignment="Center" Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                     Text="You can also drag a pilot file onto this window. Close the game before editing its pilots." />
        </StackPanel>

        <!-- Settings -->
        <DockPanel Classes="page" IsVisible="{Binding ShowSettings}" Margin="16,10,16,10">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0">
              <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Where each game keeps its pilots. Folders found automatically are filled in; anything you choose here takes priority." />
            </StackPanel>
            <Button Grid.Column="1" Content="🔍 Detect again" Margin="8,0" VerticalAlignment="Center" Command="{Binding DetectCommand}" />
            <Button Grid.Column="2" Content="Done" VerticalAlignment="Center" Command="{Binding CloseSettingsCommand}" />
          </Grid>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding SettingsGames}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingsGameViewModel">
                  <StackPanel Margin="0,8,0,10">
                    <TextBlock Text="{Binding Name}" Classes="sectionTitle" />
                    <ItemsControl ItemsSource="{Binding Variants}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VariantSettingViewModel">
                          <Border Background="#0DFFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="230,*,Auto" RowDefinitions="Auto,Auto">
                              <DockPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0">
                                <views:GameIconView DockPanel.Dock="Left" Source="{Binding Icon}" Width="24" Height="24"
                                                    Margin="0,0,8,0" VerticalAlignment="Top" />
                                <StackPanel>
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                                             Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                              </DockPanel>
                              <TextBox Grid.Column="1" Grid.Row="0" Watermark="Not set"
                                       Text="{Binding FolderText, UpdateSourceTrigger=LostFocus}" />
                              <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                                <Button Content="Browse…" Command="{Binding BrowseCommand}" />
                                <Button Content="Automatic" Command="{Binding AutoCommand}" IsEnabled="{Binding CanUseAuto}"
                                        ToolTip.Tip="Forget your choice and use the folder found automatically." />
                                <Button Content="None" Command="{Binding ClearCommand}"
                                        ToolTip.Tip="Do not use a folder for this version." />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Text="{Binding Status}"
                                         Classes="muted" FontSize="12" Margin="2,4,0,0" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- Editor -->
        <Grid Classes="page" IsVisible="{Binding ShowEditor}" RowDefinitions="Auto,*,5,160">

          <Border Grid.Row="0" Padding="14,10" Background="#0FFFFFFF">
            <DockPanel>
            <!-- X-Wing: the face the DOS game picks from the pilot's name, and the name itself (it is the file name). -->
            <StackPanel DockPanel.Dock="Left" IsVisible="{Binding IsXWingPilot}" Margin="0,0,14,0" Spacing="4"
                        ToolTip.Tip="{Binding PortraitHelp}">
              <Border Width="{Binding PortraitWidth}" Height="{Binding PortraitHeight}" Background="#22000000"
                      BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                <Panel>
                  <Image Source="{Binding Portrait}" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"
                         IsVisible="{Binding HasPortrait}" />
                  <TextBlock Text="?" FontSize="40" FontWeight="Bold" Foreground="#F44336" Opacity="0.8"
                             HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoPortrait}" />
                </Panel>
              </Border>
              <TextBlock Text="{Binding PortraitCaption}" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="2">
              <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Convert / export…"
                        Command="{Binding ConvertCommand}" IsVisible="{Binding CanConvert}"
                        ToolTip.Tip="Write this pilot for another edition of the game, or move it into or out of XWVM." />
                <TextBlock Text="{Binding PilotTitle}" FontSize="22" FontWeight="SemiBold" />
              </DockPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,2" IsVisible="{Binding IsXWingPilot}">
                <TextBlock Text="Pilot name" VerticalAlignment="Center" />
                <TextBox Text="{Binding PilotNameDraft, UpdateSourceTrigger=PropertyChanged}" Width="200"
                         ToolTip.Tip="Type a name to see the face the game gives it. Rename renames the pilot file." />
                <Button Content="Rename" Command="{Binding RenameCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding RenameError}" IsVisible="{Binding HasRenameError}" Classes="error" />
              <TextBlock Text="{Binding FormatTitle}" />
              <TextBlock Text="{Binding FilePath}" Classes="muted" FontSize="12" TextTrimming="PathSegmentEllipsis" />
              <ItemsControl ItemsSource="{Binding Notes}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding StringFormat='ℹ {0}'}" TextWrapping="Wrap" FontSize="12" Classes="muted" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            </DockPanel>
          </Border>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="340" MinWidth="200" />
              <ColumnDefinition Width="5" />
              <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>
            <TreeView Grid.Column="0" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Margin="4" Padding="0,0,14,0">
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:GroupNode" ItemsSource="{Binding Children}">
                  <TextBlock Text="{Binding Title}" />
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <DockPanel Grid.Column="2" Margin="6,4,8,4">
              <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Watermark="Search every value (Ctrl+F)…" Text="{Binding SearchText}" />
              <TextBlock DockPanel.Dock="Top" Text="{Binding ListHeader}" FontWeight="SemiBold" Margin="2,8,0,6" TextTrimming="CharacterEllipsis" />
              <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyListHint}" Classes="muted" Margin="2,0,0,0"
                         IsVisible="{Binding EmptyListHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <!-- Right padding keeps the value boxes clear of the scroll bar, which is drawn over the list. -->
              <ListBox x:Name="FieldList" ItemsSource="{Binding VisibleFields}" Background="Transparent" Padding="0,0,22,0">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6,4" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FieldViewModel">
                    <Grid ColumnDefinitions="*,280" ToolTip.Tip="{Binding Help}">
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Classes.modified="{Binding IsModified}" />
                        <TextBlock Text="{Binding GroupPath}" IsVisible="{Binding ShowGroup}" Classes="muted" FontSize="11" />
                        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="error" TextWrapping="Wrap" />
                      </StackPanel>
                      <Panel Grid.Column="1" VerticalAlignment="Center">
                        <TextBox IsVisible="{Binding IsInteger}" IsEnabled="{Binding IsEditable}"
                                 Text="{Binding IntegerText, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right" />
                        <ComboBox IsVisible="{Binding IsChoice}" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ChoiceItems}" SelectedItem="{Binding SelectedChoice}" />
                        <CheckBox IsVisible="{Binding IsFlag}" IsEnabled="{Binding IsEditable}" IsChecked="{Binding FlagValue}" />
                        <TextBox IsVisible="{Binding IsText}" IsEnabled="{Binding IsEditable}"
                                 Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" />
                      </Panel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>

          <GridSplitter Grid.Row="2" ResizeDirection="Rows" />

          <DockPanel Grid.Row="3" Margin="8,4">
            <TextBlock DockPanel.Dock="Top" Text="{Binding IssueSummary}" FontWeight="SemiBold" Margin="2,0,0,4" />
            <ListBox ItemsSource="{Binding Issues}" SelectedItem="{Binding SelectedIssue}" Background="Transparent" Padding="0,0,22,0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:IssueViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Icon}" />
                    <StackPanel>
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Location}" Classes="muted" FontSize="11" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </Panel>
    </Grid>
  </DockPanel>
</Window>
